# Ochrona dla hostingów, na których nie da się wskazać katalogu public/
# jako katalogu domeny. Ruch trafia do public/, a kod aplikacji pozostaje niedostępny.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokada katalogów z kodem, konfiguracją i pamięcią podręczną.
    RewriteRule ^(config|src|cache|tests|bin|deploy)(/|$) - [F,L]

    # Przepisanie do public/ wykonywane tylko dla pierwotnego żądania.
    # Warunek na REDIRECT_STATUS zapobiega pętli przepisań i działa również wtedy,
    # gdy aplikacja leży w podkatalogu domeny (wtedy REQUEST_URI nie zaczyna się od /public/).
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "\.(md|sh|dist|lock|example\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
